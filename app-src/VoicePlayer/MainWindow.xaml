<Window x:Class="VoicePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="原神语音播放器"
        Height="880" Width="1460" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" Icon="app.ico"
        Background="#0B101A" FontFamily="Microsoft YaHei UI, Microsoft YaHei"
        Foreground="#F2F6FC" Closed="Window_Closed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <LinearGradientBrush x:Key="MicaBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#940E1624" Offset="0"/>
            <GradientStop Color="#6B0C1420" Offset="0.5"/>
            <GradientStop Color="#840F1828" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MicaStroke" Color="#2EFFFFFF"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- ======== 背景层：模糊立绘 → 轻遮罩 → 原图立绘（不动） ======== -->
        <Image x:Name="BlurBg" Grid.Row="0" Grid.RowSpan="3" Stretch="UniformToFill" Opacity="0.85" IsHitTestVisible="False"/>
        <Rectangle Grid.Row="0" Grid.RowSpan="3" Fill="#5E0A101C" IsHitTestVisible="False"/>
        <Image x:Name="HeroImg" Grid.Row="0" Grid.RowSpan="3" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
               Margin="340,46,12,64" Opacity="0.94" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- ======== 顶部标题栏（无边框 + 窗控） ======== -->
        <Grid Grid.Row="0" Background="#26000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="14,0,6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="—" Click="BtnMin_Click"/>
                    <Button x:Name="BtnMax" Style="{StaticResource WinBtn}" Content="▢" Click="BtnMax_Click"/>
                    <Button x:Name="BtnClose" Style="{StaticResource WinBtnClose}" Content="✕" Click="BtnClose_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="logo.png" Width="26" Height="26" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#FFE6B0"
                               Text="原神语音播放器 · 本地全量语音 &amp; 地区音乐"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- ======== 主体 ======== -->
        <Grid Grid.Row="1" Margin="12,6,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：角色 / 音乐 列表 -->
            <Border Grid.Column="0" CornerRadius="14" Background="{StaticResource MicaBrush}"
                    BorderBrush="{StaticResource MicaStroke}" BorderThickness="1">
                <DockPanel Margin="10">
                    <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="2,2,2,8">
                        <Button x:Name="TabChars" Style="{StaticResource TabBtn}" Content="角色" Click="TabChars_Click"/>
                        <Button x:Name="TabMusic" Style="{StaticResource TabBtn}" Content="地区音乐" Click="TabMusic_Click"/>
                    </UniformGrid>
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,8">
                        <TextBox x:Name="SearchBox" Padding="8,6"
                                 Background="#40141B2A" Foreground="#F2F6FC" BorderBrush="#55FFFFFF" BorderThickness="1"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchBoxHint" Text="搜索角色…" Foreground="#66B0C4D8" FontSize="12"
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <TextBlock x:Name="ListHint" DockPanel.Dock="Bottom" Foreground="#9AB0C4D8" FontSize="11" Margin="4,6,0,0"/>
                    <ListBox x:Name="LeftList" IsSynchronizedWithCurrentItem="False" SelectionChanged="LeftList_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="2,10,2,4" Padding="8,4" CornerRadius="8" Background="#38FFD08C">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#FFE6B0"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Border x:Name="IconBox" Width="44" Height="44" CornerRadius="8" ClipToBounds="True"
                                            Background="#22FFFFFF" Margin="0,0,10,0">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Display}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="#C9D8EA"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右：语音列表 -->
            <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="14" Background="{StaticResource MicaBrush}"
                    BorderBrush="{StaticResource MicaStroke}" BorderThickness="1">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8">
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
                            <Button x:Name="ImportBtn" Style="{StaticResource MiniBtn}" HorizontalAlignment="Right"
                                    Margin="8,0,0,6" Content="导入数据源…" Click="ImportSource_Click"/>
                            <TextBlock x:Name="HintText" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                       Foreground="#9AB0C4D8" FontSize="11"/>
                        </StackPanel>
                        <TextBlock x:Name="HeaderText" FontSize="22" FontWeight="Bold" Foreground="#FFE6B0" Text="请选择左侧条目"/>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,8">
                        <ToggleButton x:Name="ModeAll" Style="{StaticResource MiniToggle}" Content="全量搜索" IsChecked="True" Click="ModeAll_Click"/>
                        <ToggleButton x:Name="ModeCur" Style="{StaticResource MiniToggle}" Content="当前角色" Click="ModeCur_Click"/>
                    </StackPanel>
                    <Grid DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBox x:Name="VSearch" Padding="8,6"
                                 Background="#40141B2A" Foreground="#F2F6FC" BorderBrush="#55FFFFFF" BorderThickness="1"
                                 TextChanged="VSearch_TextChanged"/>
                        <TextBlock x:Name="VSearchHint" Text="搜索台词 / 条目名…" Foreground="#66B0C4D8" FontSize="12"
                                   Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ListBox x:Name="VoiceList" Background="Transparent" BorderThickness="0"
                             IsSynchronizedWithCurrentItem="False"
                             MouseDoubleClick="VoiceList_MouseDoubleClick"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Margin="2,10,2,4" Padding="8,4" CornerRadius="8" Background="#33FFD08C">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFE6B0"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource PlayBtn}"
                                            Click="PlayBtn_Click" MouseEnter="PlayBtn_MouseEnter">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="导出当前语音" Click="ExportBtn_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap"
                                               FontSize="14.5" LineHeight="22" VerticalAlignment="Center">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="导入数据源…" Click="ImportSource_Click"/>
                                                <Separator/>
                                                <MenuItem Header="复制文本" Click="CopyText_Click"/>
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======== 底部播放条 ======== -->
        <Border Grid.Row="2" Background="#660B1220" BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0">
            <Grid Margin="16,6,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0">
                    <TextBlock x:Name="NowPlaying" DockPanel.Dock="Left" Foreground="#FFD08C" VerticalAlignment="Center"
                               Width="300" TextTrimming="CharacterEllipsis" Text="就绪"/>
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Foreground="#B8C6D8" VerticalAlignment="Center"
                               Margin="10,0,0,0" Text="00:00 / 00:00"/>
                    <Slider x:Name="PosSlider" Minimum="0" Maximum="1000" Margin="10,0,0,0" VerticalAlignment="Center"
                            PreviewMouseLeftButtonDown="PosSlider_Down" PreviewMouseLeftButtonUp="PosSlider_Up"
                            ValueChanged="PosSlider_Changed"/>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="音量" Foreground="#9AB0C4D8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="1" Value="0.8"
                            VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
