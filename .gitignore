# ── 构建中间产物（可随时重建）────────────────────────────
app-src/**/bin/
app-src/**/obj/
bin/
obj/
installer.wxs
installer-ui/preview-*.png
*.wixpdb

# ── dist：只保留 ASCII 名安装包（走 LFS），其余忽略 ────────
dist/*
!dist/VoicePlayer-Setup-1.0.0.exe

# ── 本机配置与临时文件 ─────────────────────────────
config.json
selftest.txt
*.log

# ── Python 缓存（不应跟踪）──────────────────────────────────
__pycache__/
*.pyc
*.pyo
